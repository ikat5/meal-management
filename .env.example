# Copy this file to .env.local and fill in the real values.

# Replace <db_password> with your MongoDB Atlas password
# (URL-encode special characters: @ → %40, : → %3A, etc.)
MONGODB_URI=mongodb+srv://tarit1243_db_user:<db_password>@mealsystem.htdby7i.mongodb.net/meal_management?retryWrites=true&w=majority

# Generate with:  openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# Protects the daily /api/cron/tick endpoint (auto-schedule + auto-reset).
# Generate with:  openssl rand -base64 32
CRON_SECRET=replace-me-with-a-different-long-random-string

# Meal cancellations for tomorrow must arrive before this hour today (24h clock)
MEAL_CANCEL_CUTOFF_HOUR=22

# Timezone for all "what day is it?" logic
APP_TIMEZONE=Asia/Dhaka
